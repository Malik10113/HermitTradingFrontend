# Local development values. systemd does not read this file: put production
# values in a drop-in (`systemctl edit hermit-frontend`) or an EnvironmentFile.
# Bind loopback only; expose with `tailscale serve`, never Funnel.
HTF_HOST=127.0.0.1
HTF_PORT=8787
# Optional shared secret for defence in depth. The browser sends Bearer <token>.
# Never commit a real token.
# HTF_APP_TOKEN=change-me
# Read-only sibling data; defaults to /root/FundedBetBacktesting/data.
# HTF_DATA_ROOT=/root/FundedBetBacktesting/data
# Generated state; defaults to ./var.
# HTF_VAR=/root/HermitTradingFrontend/var
