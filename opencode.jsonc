{
  "$schema": "https://opencode.ai/config.json",

  // No root `model` is set on purpose: the orchestrator runs on whatever model
  // the session has selected via /models. Pinning a root model would override
  // that default for new sessions.
  "default_agent": "orchestrator",

  "agents": {
    "orchestrator": {
      "mode": "primary",
      "description": "Plans the work and dispatches one implementer per task"
    },

    // Used only by the parallel skill's executors, so cheap work stays cheap
    // without changing the model for any other subagent call.
    "implementer": {
      "mode": "subagent",
      "description": "Parallel-skill executor: implements one scoped atom in its own worktree",
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },

    // Same pinned model as the executor, but read-only: it reports findings and
    // never edits, merges or commits. Shell stays allowed because the review
    // needs `git diff` and the acceptance script.
    "reviewer": {
      "mode": "subagent",
      "description": "Parallel-skill reviewer: read-only findings on an integrated wave",
      "model": "opencode-go/deepseek-v4.1-flash#high",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    },

    // Stands in for `explore` inside the skill, which is why it is read-only:
    // search and read before a dispatch, never write.
    "recon": {
      "mode": "subagent",
      "description": "Parallel-skill recon: read-only search and reading before dispatch",
      "model": "opencode-go/deepseek-v4.1-flash#high",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  }
}
